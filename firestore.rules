rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isConvMember() {
      return isSignedIn()
        && resource.data.keys().hasAny(['members'])
        && request.auth.uid in resource.data.members;
    }
    function isConvMemberOnCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAny(['members'])
        && request.auth.uid in request.resource.data.members;
    }
    function conversationExists(cid) {
      return exists(/databases/$(database)/documents/conversations/$(cid));
    }
    function isInConversation(cid) {
      return isSignedIn()
        && conversationExists(cid)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members;
    }
    function withinDeleteWindow() {
      return resource.data.keys().hasAll(['createdAt'])
        && request.time.toMillis() - resource.data.createdAt.toMillis() <= 86400000;
    }
    function onlyReactionsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }
    function isValidDeleteForEveryone() {
      return resource.data.senderId == request.auth.uid
        && resource.data.get('deleted', false) != true
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && withinDeleteWindow();
    }

    match /users/{uid} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /privateUsers/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-z0-9_]{3,32}$');
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /contacts/{uid}/list/{contactId} {
      allow read, write: if isOwner(uid);
    }
    match /blocks/{uid}/list/{blockedUid} {
      allow read, write: if isOwner(uid);
    }
    match /devices/{uid}/list/{deviceId} {
      allow read, write: if isOwner(uid);
    }

    // ★ conversations — list uses members[] (NOT conversationMembers exists)
    match /conversations/{cid} {
      allow get: if isSignedIn() && (
        resource == null ||
        (resource.data.keys().hasAny(['members'])
          && request.auth.uid in resource.data.members)
      );
      allow list: if isConvMember();
      allow create: if isConvMemberOnCreate()
                    && request.resource.data.type in ['direct', 'group']
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 2;
      allow update: if isConvMember();
      allow delete: if false;
    }

    match /conversationMembers/{cid}/members/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isInConversation(cid)
      );
      allow create: if isSignedIn() && (
        request.auth.uid == uid || isInConversation(cid)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == uid || isInConversation(cid)
      );
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /messages/{cid}/messages/{mid} {
      allow read: if isInConversation(cid);
      allow create: if isInConversation(cid)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.keys().hasAll(['senderId', 'type', 'createdAt']);
      allow update: if isInConversation(cid) && (
        onlyReactionsChanged() || isValidDeleteForEveryone()
      );
      allow delete: if false;
    }

    match /calls/{callId} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAny(['participants'])
                    && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if isSignedIn()
                    && resource.data.keys().hasAny(['participants'])
                    && request.auth.uid in resource.data.participants;
    }

    match /reports/{rid} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}